Algoritmo Dias_del_mes
	
	definir dia como entero;
	
	escribir "Ingrese el numero del mes para saber cuantos dias lo componen";
	leer dia;
	
	Segun dia hacer
		
		1:
			dia = 1
			escribir "Enero tiene 31 dias";
			
		2:
			dia = 2
			escribir "No se cuenta con la infromacion necesaria para dar la respuesta";
			
		3:
			dia = 3
			escribir "Marzo tiene 31 dias";
			
		4:
			dia = 4
			escribir "Abril tiene 30 dias";
			
		5:
			dia = 5
			escribir "Mayo tiene 31 dias";
			
		6:
			dia = 6
			escribir "Junio tiene 30 dias";
			
		7:
			dia = 7 
			escribir "Julio tiene 31 dias";
			
		8:
			dia = 8
			escribir "Agosto tiene 31 dias";
			
		9:
			dia = 9
			escribir "Septiembre tiene 30 dias";
			
		10:
			dia = 10
			escribir "Octubre tiene 30 dias";
			
		11:
			dia = 10
			escribir "Noviembre tiene 30 dias";
			
		12:
			dia = 12
			escribir "Diciembre tiene 31 dias";
			
		De Otro Modo:
			
			Escribir "No existe este mes"
			
	Fin Segun
	
	
	
FinAlgoritmo

